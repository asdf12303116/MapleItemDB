<Window x:Class="MapleItemDB.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MapleItemDB.UI.ViewModels"
        xmlns:converters="clr-namespace:MapleItemDB.UI.Converters"
        mc:Ignorable="d"
        Title="MapleItemDB - 道具数据库" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:ItemCategoryConverter x:Key="CategoryConverter"/>
        <converters:SubCategoryConverter x:Key="SubCategoryConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:FlagToColorConverter x:Key="FlagToColorConverter"/>
        <converters:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibilityConverter"/>
        <converters:TimeLimitedConverter x:Key="TimeLimitedConverter"/>
        <converters:BindingProxy x:Key="VmProxy" Data="{Binding}"/>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏: 分类筛选 + 子分类筛选 + SN 筛选 + 搜索 + 清除 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 分类下拉框 -->
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding SelectedCategoryOption}"
                      DisplayMemberPath="Label"
                      Width="80"
                      VerticalContentAlignment="Center"
                      Margin="0,0,8,0"/>

            <!-- 装备子分类下拉框 -->
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding EquipSubCategoryOptions}"
                      SelectedItem="{Binding SelectedSubCategoryOption}"
                      DisplayMemberPath="Label"
                      Width="100"
                      VerticalContentAlignment="Center"
                      Margin="0,0,8,0"
                      Visibility="{Binding IsEquipSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- SN 筛选下拉框 (装备/现金) -->
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding SnFilterOptions}"
                      SelectedItem="{Binding SelectedSnFilterOption}"
                      DisplayMemberPath="Label"
                      Width="100"
                      VerticalContentAlignment="Center"
                      Margin="0,0,8,0"
                      Visibility="{Binding ShowSnFeatures, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <TextBox Grid.Column="3"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Padding="6,4"
                     FontSize="14">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="4"
                    Content="搜索"
                    Margin="8,0,0,0"
                    Padding="16,6"
                    Command="{Binding SearchCommand}"/>

            <!-- 清除搜索按钮 -->
            <Button Grid.Column="5"
                    Content="✕"
                    Margin="4,0,0,0"
                    Padding="8,6"
                    ToolTip="清除搜索"
                    Command="{Binding ClearSearchCommand}"/>
        </Grid>

        <!-- 中间主区域: 左侧列表 + 右侧详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 搜索结果列表 -->
            <DataGrid x:Name="SearchResultsGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding SearchResults}"
                      SelectedItem="{Binding SelectedItem}"
                      SelectionChanged="OnSearchResultSelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Margin="0,0,4,0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制名称" Command="{Binding CopySelectedItemNameCommand}"/>
                        <MenuItem Header="复制ID" Command="{Binding CopySelectedItemIdCommand}"/>
                        <MenuItem Header="复制SN"
                                  Command="{Binding Data.CopySelectedItemSnCommand, Source={StaticResource VmProxy}}"
                                  Visibility="{Binding Data.ShowSnFeatures, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ItemId}" Width="80"/>
                    <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="80"
                                        Visibility="{Binding Data.ShowSnFeatures, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="分类" Binding="{Binding Category, Converter={StaticResource CategoryConverter}}" Width="50"/>
                    <DataGridTextColumn Header="子分类" Binding="{Binding SubCategory, Converter={StaticResource SubCategoryConverter}}" Width="60"
                                        Visibility="{Binding Data.ShowSubCategoryAndLevel, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <DataGridTextColumn Header="等级" Binding="{Binding ReqLevel}" Width="45"
                                        Visibility="{Binding Data.ShowSubCategoryAndLevel, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <DataGridTextColumn Header="限时" Binding="{Binding TimeLimited, Converter={StaticResource TimeLimitedConverter}}" Width="50"
                                        Visibility="{Binding Data.ShowTimeLimitedColumn, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 道具详情面板 -->
            <ScrollViewer Grid.Column="1" Margin="4,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="道具详情" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- 基础信息 -->
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,8"
                            DataContext="{Binding SelectedItem}"
                            Visibility="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToCollapsedConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标 (48x48 Border, 36x36 Image) -->
                            <Border Grid.Column="0"
                                    Width="48" Height="48"
                                    Background="#F0F0F0"
                                    Margin="0,0,12,0"
                                    CornerRadius="4">
                                <Image Source="{Binding IconData, Converter={StaticResource ByteArrayToImageConverter}}"
                                       Width="36" Height="36"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <!-- 名称和分类 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="ID: "/><Run Text="{Binding ItemId, Mode=OneWay}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding DataContext.SelectedItemCategoryDisplay, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 预览图 (外观装备) -->
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,8"
                            Visibility="{Binding SelectedItem.PreviewData, Converter={StaticResource NullToCollapsedConverter}}">
                        <StackPanel>
                            <TextBlock Text="预览" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Image Source="{Binding SelectedItem.PreviewData, Converter={StaticResource ByteArrayToImageConverter}}"
                                   MaxHeight="128"
                                   HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </StackPanel>
                    </Border>

                    <!-- 装备属性 -->
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,8"
                            Visibility="{Binding HasFormattedStats, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="属性" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding FormattedStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{Binding IsFlag, Converter={StaticResource FlagToColorConverter}}"
                                                   Margin="0,2"
                                                   FontSize="13"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 套装效果 -->
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,8"
                            Visibility="{Binding HasSetItem, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="套装效果" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SetItemDisplayText}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <!-- 技能详情 (技能搜索模式) -->
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,8"
                            Visibility="{Binding SkillDetailText, Converter={StaticResource NullToCollapsedConverter}}">
                        <StackPanel>
                            <TextBlock Text="技能详情" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock converters:MapleTextHelper.MapleText="{Binding SkillDetailText}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态栏 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 非提取时显示 StatusText -->
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsExtracting, Converter={StaticResource InvertBoolToVisibilityConverter}}"/>

            <!-- 提取时显示 ExtractionStatus -->
            <TextBlock Grid.Column="0"
                       Text="{Binding ExtractionStatus}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <ProgressBar Grid.Column="1"
                         Width="200" Height="16"
                         Value="{Binding ExtractionProgress}"
                         Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="8,0,0,0"/>

            <!-- 百分比文本 -->
            <TextBlock Grid.Column="2"
                       Text="{Binding ExtractionProgress, StringFormat={}{0:F0}%}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibilityConverter}}"
                       Margin="4,0,0,0"
                       MinWidth="36"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="更新wz数据"
                        Padding="12,4"
                        Margin="0,0,8,0"
                        Click="OnExtractClick"
                        IsEnabled="{Binding IsExtracting, Converter={StaticResource InvertBoolConverter}}"/>
                <Button Content="更新SN数据"
                        Padding="12,4"
                        Click="OnUpdateSnClick"
                        IsEnabled="{Binding IsExtracting, Converter={StaticResource InvertBoolConverter}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
